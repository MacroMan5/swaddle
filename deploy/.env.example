# Copiez ce fichier vers .env, puis adaptez-le à votre serveur.
SWADDLE_IMAGE=ghcr.io/macroman5/swaddle:v0.1.0
SWADDLE_PORT=3010
SWADDLE_DATA_DIR=./data
TZ=UTC
# URL complète utilisée par les navigateurs du foyer pour joindre l'app —
# voir README.md. Sans elle, le conteneur refuse de démarrer.
#   - accès direct par le port : http://<ip-du-pi>:3010
#   - derrière le vhost nginx documenté dans README.md : http://swaddle.home
SWADDLE_ORIGIN=http://swaddle.home
