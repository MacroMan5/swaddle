		"bits-ui": "^2.19.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fontsource/archivo": "^5.3.0",
